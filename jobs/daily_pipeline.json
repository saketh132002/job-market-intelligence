{
  "name": "daily_pipeline",
  "email_notifications": {
    "no_alert_for_skipped_runs": false
  },
  "webhook_notifications": {},
  "timeout_seconds": 0,
  "schedule": {
    "quartz_cron_expression": "36 0 6 * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingest_adzuna",
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/02_ingestion/01_ingest_adzuna",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "parse_staging",
      "depends_on": [
        {
          "task_key": "ingest_adzuna"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/00_parse_bronze_to_silver",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "normalize_titles",
      "depends_on": [
        {
          "task_key": "parse_staging"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/01_normalize_titles",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "parse_salaries",
      "depends_on": [
        {
          "task_key": "normalize_titles"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/02_parse_salaries",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "dedupe_postings",
      "depends_on": [
        {
          "task_key": "parse_salaries"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/03_dedupe_postings",
        "source": "GIT"
      },
      "timeout_seconds": 0,
      "email_notifications": {},
      "webhook_notifications": {},
      "disabled": false
    },
    {
      "task_key": "merge_to_silver",
      "depends_on": [
        {
          "task_key": "dedupe_postings"
        }
      ],
      "run_if": "ALL_SUCCESS",
      "notebook_task": {
        "notebook_path": "notebooks/03_silver/04_merge_to_silver",
        "source": "GIT"
      },
